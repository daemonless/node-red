ARG BASE_VERSION=15.1
FROM ghcr.io/daemonless/base:${BASE_VERSION}

ARG NODERED_VERSION=5.0.8

ARG FREEBSD_ARCH=amd64
ARG UPSTREAM_URL="https://api.github.com/repos/node-red/node-red/releases/latest"
ARG UPSTREAM_JQ=".tag_name"
ARG HEALTHCHECK_ENDPOINT="http://localhost:1880/"
ARG PACKAGES="node24 npm-node24"

LABEL org.opencontainers.image.title="Node-RED" \
      org.opencontainers.image.description="Low-code programming for event-driven applications on FreeBSD." \
      org.opencontainers.image.source="https://github.com/daemonless/node-red" \
      org.opencontainers.image.url="https://nodered.org/" \
      org.opencontainers.image.documentation="https://nodered.org/docs" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="Utilities" \
      io.daemonless.port="1880" \
      io.daemonless.volumes="/config" \
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.base="node" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}" \
      io.daemonless.healthcheck-url="${HEALTHCHECK_ENDPOINT}" \
      io.daemonless.packages="${PACKAGES}"


ENV NODERED_HOME "/config"

ENV NODE_ENV production

RUN pkg update && pkg install -y python3 ${PACKAGES} && \
    npm install -g node-red@${NODERED_VERSION} && \
		mkdir -p /app && echo "${NODERED_VERSION}" > /app/version && chmod -R a+rX /app && \
    pkg clean -a && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/* && \
    find /usr/local -name '*.a' -delete && \
    rm -rf /usr/local/share/doc /usr/local/share/man /usr/local/include /usr/local/llvm19/include /usr/local/llvm19/bin && \
    rm -rf /usr/local/libexec/gcc14 /usr/local/bin/*-portbld-freebsd* /usr/local/*-portbld-freebsd* && \
    rm -f /usr/local/bin/gcc* /usr/local/bin/g++* /usr/local/bin/gfortran* /usr/local/bin/cpp* /usr/local/bin/c++* && \
    rm -f /usr/local/lib/libopcodes* /usr/local/lib/libbfd*

RUN install -d -o bsd -g bsd "${NODERED_HOME}" && chown -R bsd:bsd "${NODERED_HOME}"

VOLUME "${NODERED_HOME}"

EXPOSE 1880

COPY root/ /

RUN chmod +x /etc/services.d/node-red/run /healthz

